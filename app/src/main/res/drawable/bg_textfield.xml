<?xml version="1.0" encoding="utf-8"?>
<!-- Editable text field background (drop-pin dialog's Name field, and anywhere else a dark-
     theme text box needs to read as tappable) — a lighter fill than the dialog card behind it
     (#1A1B1E) plus a faint border, replacing the EditText's default underline, which was
     nearly invisible against the dark dialog theme. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#2A2B2E" />
    <corners android:radius="8dp" />
    <stroke android:width="1dp" android:color="#454649" />
</shape>

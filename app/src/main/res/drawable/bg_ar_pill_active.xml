<?xml version="1.0" encoding="utf-8"?>
<!-- Active state of the flight-screen AR pill. Same geometry as bg_zoom_pill so the button does
     not resize when it turns on (a control that changes size on tap reads as a different
     control); only the colour carries the state, in the app's status green #4CAF50. The AR
     overlay is easy to leave running by accident over a busy picture, so "is it on" has to be
     answerable from across the screen rather than by reading a 12sp label's tint. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <solid android:color="#4D4CAF50" />
    <stroke android:width="1.5dp" android:color="#FF4CAF50" />
</shape>

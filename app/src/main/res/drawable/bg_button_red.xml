<?xml version="1.0" encoding="utf-8"?>
<!-- Red action button (Reset Numbering / Clear All Markers, markers-list dialog) — rounded
     rect, solid fill, a darker-red outline so it reads as a raised button rather than a flat
     colored label. Pressed state darkens both fill and outline for touch feedback since the
     button uses a custom background (no default Material ripple/elevation). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#C62828" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="#8E0000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EF5350" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="#B71C1C" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Mini-map zoom toggle. Darker and less contrasty than bg_zoom_pill (the camera zoom control
     on the toolbar): this one sits ON the map, so it has to stay legible against both pale
     street tiles and dark satellite/custom imagery without hiding the ground underneath it. A
     dark scrim with a light hairline reads on either. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="6dp" />
    <solid android:color="#B3000000" />
    <stroke android:width="1dp" android:color="#80FFFFFF" />
</shape>

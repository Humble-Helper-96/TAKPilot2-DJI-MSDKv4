<resources>
            <style name="AppTheme.NoActionBar">
            <item name="windowActionBar">false</item>
            <item name="windowNoTitle">true</item>
            <item name="android:windowDrawsSystemBarBackgrounds">true</item>
            <item name="android:statusBarColor">@android:color/transparent</item>
        </style>
            <!-- Home screen: no ActionBar/title, but a SOLID status bar (not transparent) —
                 the home layout doesn't go immersive/fullscreen like the flight screen does
                 (which manually handles insets via systemUiVisibility), so a transparent
                 status bar here left an unpainted gap: content is inset below it via padding,
                 but nothing draws INTO that inset strip, and the platform's default light
                 status-bar scrim showed through instead of the app's dark background. -->
            <style name="AppTheme.NoActionBar.SolidStatusBar">
            <item name="android:windowDrawsSystemBarBackgrounds">true</item>
            <item name="android:statusBarColor">#0E0E10</item>
        </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- "Dropped Markers" panel body (TAKPilot2GoFlightActivity.onMarkersListTapped): just the
     marker list. "Clear All Markers" lives in the dialog's own button bar (neutral button,
     bottom-left, in line with Close) instead of a row in here — see onMarkersListTapped. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <ListView
        android:id="@+id/markersListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="#2A2A2A"
        android:dividerHeight="1px" />
</LinearLayout>

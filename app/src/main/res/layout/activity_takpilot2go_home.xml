<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0E0E10"
    android:padding="20dp"
    android:baselineAligned="false">

    <!-- LEFT: logo + status + Quick Controls. Scrolls instead of silently squashing the last
         button to nothing when the card's content doesn't fit the screen's vertical budget —
         LinearLayout has no built-in overflow handling of its own (bit us when a 4th Quick
         Controls button was added: it measured down to ~1dp tall instead of just running off
         the bottom, since its wrap_content child got an AT_MOST spec capped to whatever sliver
         of space was left). -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingEnd="20dp">

        <!-- Logo + app name + TAK connection indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/takpilot2_logo"
                android:layout_marginEnd="12dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Bound to the same string as the launcher label so the two can't drift
                     apart the next time the app is renamed. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/sample_app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <View
                        android:id="@+id/homeTakDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tak_status_dot" />
                    <TextView
                        android:id="@+id/homeTakStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TAK: Disconnected"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Controls -->
        <LinearLayout style="@style/homeCard">
            <TextView style="@style/homeCardTitle" android:text="Quick Controls" />
            <Button
                android:id="@+id/homeTakSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Pre-Flight Setup"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32" />
            <Button
                android:id="@+id/homeQuit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="STOP / QUIT"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B71C1C" />
            <Button
                android:id="@+id/homeDataSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Data Sync"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
            <Button
                android:id="@+id/homeDebugLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Debug Log"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- RIGHT: the whole card IS the Enter Flight button (clickable, ripple feedback) -->
    <LinearLayout
        android:id="@+id/homeEnterFlight"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/home_flight_card_clickable"
        android:clickable="true"
        android:focusable="true"
        android:padding="24dp">

        <View android:layout_width="0dp" android:layout_height="0dp" />

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/takpilot2_logo"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENTER FLIGHT"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live FPV · Telemetry · TAK"
            android:textColor="#9AC4FF"
            android:textSize="15sp"
            android:layout_marginTop="6dp" />

        <!-- Aircraft info, centered under the title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="18dp">
            <TextView style="@style/homeCardTitle" android:text="Aircraft"
                android:layout_gravity="center_horizontal" />
            <TextView android:id="@+id/homeAircraft" style="@style/homeCardValue"
                android:text="—" android:layout_gravity="center_horizontal" />
            <TextView android:id="@+id/homeSdk" style="@style/homeCardSub"
                android:text="MSDK —" android:layout_gravity="center_horizontal" />
        </LinearLayout>

        <!-- Spacer pushes the tap hint to the bottom -->
        <View android:layout_width="0dp" android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="TAP TO ENTER ›"
            android:textColor="#9AC4FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>
</LinearLayout>

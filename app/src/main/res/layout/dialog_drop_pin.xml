<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the "drop a marker at the crosshair" dialog (see
     TAKPilot2GoFlightActivity.onDropPinTapped). Affiliation picker + editable name; the
     Drop/Cancel buttons come from the AlertDialog itself.
     Text colors are hardcoded rather than left to inherit from TakDialogTheme: this view is
     inflated via the Activity's own layoutInflater (Activity theme = AppTheme, light-ish),
     not the AlertDialog's themed one, so theme-attr text colors here never resolved against
     TakDialogTheme and rendered black-on-dark instead. Same fix pattern as IconListAdapter's
     row_marker_type.xml, which hardcodes for the same reason. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/dropPinLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Type"
        android:textColor="#AAAAAA"
        android:textSize="12sp" />

    <!-- The icons themselves are the picker — tapping one selects it (outlined via
         bg_marker_type_selected, toggled in TAKPilot2GoFlightActivity.onDropPinTapped), no
         separate radio dot. Default selection (Unknown) is set in code, not here, so it stays
         next to the rest of the selection-state logic. -->
    <LinearLayout
        android:id="@+id/dropPinAffiliation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/dropPinFriendly"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:padding="6dp">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/marker_friendly"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Friendly"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dropPinHostile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:padding="6dp">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/marker_hostile"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hostile"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dropPinNeutral"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:padding="6dp">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/marker_neutral"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Neutral"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dropPinUnknown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:padding="6dp">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/marker_unknown"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Unknown"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Name"
        android:textColor="#AAAAAA"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/dropPinName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_textfield"
        android:padding="10dp"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:textSize="15sp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 1. Drone Settings — flight-safety limits, all optional (blank = leave the
             aircraft's own default alone). Feet in the UI, converted to meters for the SDK. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Drone Settings"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Applied automatically when the aircraft connects. Leave a field blank to use the aircraft's own current setting."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="12dp" />

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Max altitude (ft)" />
                <EditText
                    android:id="@+id/limitMaxAltitude"
                    style="@style/takFieldStyle"
                    android:hint="e.g. 400"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Max distance (ft)" />
                <EditText
                    android:id="@+id/limitMaxRadius"
                    style="@style/takFieldStyle"
                    android:hint="e.g. 1600"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="RTH altitude (ft)" />
                <EditText
                    android:id="@+id/limitRthAltitude"
                    style="@style/takFieldStyle"
                    android:hint="e.g. 100"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- Signal-loss failsafe. This is the aircraft's own firmware behavior for a lost RC
             link, so it still applies if this app or the phone dies mid-flight. NOT the same as
             the max-distance geofence above, which only stops the aircraft at the boundary —
             see FlightLimitsController's doc comment. -->
        <TextView style="@style/takLabelStyle" android:text="If the signal is lost" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What the aircraft does on its own if it loses the controller link — including if this app or the phone stops working. Return to Home is recommended."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <RadioGroup
            android:id="@+id/limitFailsafeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/failsafeGoHome"
                style="@style/takColumnRadio"
                android:text="Return Home" />

            <RadioButton
                android:id="@+id/failsafeHover"
                style="@style/takColumnRadio"
                android:text="Hover" />

            <RadioButton
                android:id="@+id/failsafeLand"
                style="@style/takColumnRadio"
                android:text="Land" />
        </RadioGroup>

        <TextView
            android:id="@+id/limitFailsafeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingTop="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <!-- 2. Map Display — mini-map style on the flight screen. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Map Display"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <RadioGroup
            android:id="@+id/mapStyleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/mapStyleStreet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Street"
                android:textColor="#FFFFFF"
                android:buttonTint="#1565C0" />

            <RadioButton
                android:id="@+id/mapStyleHybrid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hybrid"
                android:textColor="#FFFFFF"
                android:buttonTint="#1565C0" />

            <RadioButton
                android:id="@+id/mapStyleCustom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Custom"
                android:textColor="#FFFFFF"
                android:buttonTint="#1565C0" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hybrid = satellite + streets."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingTop="2dp" />

        <TextView style="@style/takLabelStyle"
            android:paddingTop="8dp"
            android:text="Custom tile URL (used when &quot;Custom&quot; is selected)" />
        <EditText
            android:id="@+id/mapCustomUrl"
            style="@style/takFieldStyle"
            android:hint="https://host/path/{z}/{x}/{y}.png"
            android:inputType="textUri" />

        <Button
            android:id="@+id/mapDisplaySaveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Save Map Display"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. TAK Server Connection"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />

        <TextView style="@style/takLabelStyle" android:text="Server host" />
        <EditText
            android:id="@+id/takHost"
            style="@style/takFieldStyle"
            android:hint="tak.example.com"
            android:inputType="textUri" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">
                <TextView style="@style/takLabelStyle" android:text="Enroll port" />
                <EditText
                    android:id="@+id/takEnrollPort"
                    style="@style/takFieldStyle"
                    android:text="8446"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView style="@style/takLabelStyle" android:text="CoT port" />
                <EditText
                    android:id="@+id/takCotPort"
                    style="@style/takFieldStyle"
                    android:text="8089"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Username" />
                <EditText
                    android:id="@+id/takUsername"
                    style="@style/takFieldStyle"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Password" />
                <EditText
                    android:id="@+id/takPassword"
                    style="@style/takFieldStyle"
                    android:inputType="textPassword" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Drone callsign" />
                <EditText
                    android:id="@+id/takCallsign"
                    style="@style/takFieldStyle"
                    android:hint="TAKPilot2-M30"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/takCameraPoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#2E7D32" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send camera look-point (sensor point of interest)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/takConnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Enroll &amp; Connect"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />

        <Button
            android:id="@+id/takDisconnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Log Out (switch user)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555555" />

        <TextView
            android:id="@+id/takStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:text="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <!-- My Channels: pull the groups the logged-in user belongs to and pick which ones this
             drone's markers/PLI are directed to. Requires an active connection. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="My Channels"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Channels your TAK login belongs to. Selected ones receive this drone's PLI and markers (none selected = server default)."
            android:textColor="#909090"
            android:textSize="12sp" />

        <Button
            android:id="@+id/takPullChannels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pull Channels"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0" />

        <TextView
            android:id="@+id/takChannelsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B0B0B0"
            android:textSize="13sp"
            android:text="" />

        <LinearLayout
            android:id="@+id/takChannelsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. Video Streaming"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Server host" />
                <EditText
                    android:id="@+id/videoHost"
                    style="@style/takFieldStyle"
                    android:hint="stream.example.com"
                    android:inputType="textUri" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Port" />
                <EditText
                    android:id="@+id/videoPort"
                    style="@style/takFieldStyle"
                    android:text="8554"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Broadcast ID" />
                <EditText
                    android:id="@+id/videoStreamId"
                    style="@style/takFieldStyle"
                    android:hint="UAS-CALLSIGN"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Username" />
                <EditText
                    android:id="@+id/videoUser"
                    style="@style/takFieldStyle"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Password" />
                <EditText
                    android:id="@+id/videoPassword"
                    style="@style/takFieldStyle"
                    android:inputType="textPassword" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/takLabelStyle"
            android:text="Video quality (on-device transcode)"
            android:paddingTop="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transcoded on device with a 2s keyframe so remote viewers (ATAK) can join and recover cleanly. Aspect ratio is preserved. Published to a -Low path (e.g. Feed-A → Feed-A-Low) so the media server passes it through without re-transcoding. Standard is the default; Low suits marginal links."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <!-- Each option's resolution/fps/bitrate is kept on its own lines rather than dropped —
             the column is narrow, but which profile is which is exactly what the pilot is
             choosing between. "(default)"/"(marginal links)" moved into the note above. -->
        <RadioGroup
            android:id="@+id/videoProfileGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/videoProfileLow"
                style="@style/takColumnRadio"
                android:buttonTint="#1565C0"
                android:textSize="12sp"
                android:text="Low\n360p · 10fps\n275 kbps" />

            <RadioButton
                android:id="@+id/videoProfileStandard"
                style="@style/takColumnRadio"
                android:buttonTint="#1565C0"
                android:textSize="12sp"
                android:text="Standard\n480p · 15fps\n550 kbps" />

            <RadioButton
                android:id="@+id/videoProfileHigh"
                style="@style/takColumnRadio"
                android:buttonTint="#1565C0"
                android:textSize="12sp"
                android:text="High\n720p · 15fps\n1000 kbps" />

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/videoTcp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:buttonTint="#1565C0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use TCP transport (append ?tcp)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView style="@style/takLabelStyle"
            android:text="Full stream URL (push + advertised to ATAK)"
            android:paddingTop="8dp" />
        <TextView
            android:id="@+id/videoFullUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202020"
            android:padding="12dp"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:text="rtsp://…" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Starting/stopping the stream is done from the LIVE pill on the flight screen."
            android:textColor="#7A7A7A"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <!-- 5. Elevation Data (DTED) — uploaded files for the local flight area. Storage/
             management only today; SPoI elevation lookup against these is a follow-up. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5. Elevation Data (DTED)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Terrain regions for Sensor-Point-of-Interest ground accuracy — import a .zip per flight area (e.g. Anchorage.zip). Tiles are shared across regions; a repeat import overwrites in place."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/dtedUploadButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="+ Import Region"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0" />
            <Button
                android:id="@+id/dtedCleanButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clean Unused Tiles"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dtedFileList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/dtedStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B0B0B0"
            android:textSize="13sp"
            android:text="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <!-- 6. FAA Airspace Ceilings (UASFM) — downloaded once on wifi, read offline in flight.
             Advisory display only; nothing here is applied to the aircraft's flight limits. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6. FAA Airspace Ceilings (UASFM)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FAA UAS Facility Map altitude ceilings, shown on the flight HUD. Download over wifi before you head out — it is read offline in flight. Advisory only: this shows altitudes the FAA is likely to authorise, it is NOT an authorisation, and it does not change the aircraft's altitude limit."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="10dp" />

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Centre latitude" />
                <EditText
                    android:id="@+id/uasfmLat"
                    style="@style/takFieldStyle"
                    android:hint="61.2170"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Centre longitude" />
                <EditText
                    android:id="@+id/uasfmLon"
                    style="@style/takFieldStyle"
                    android:hint="-149.8925"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Radius (mi)" />
                <EditText
                    android:id="@+id/uasfmRadius"
                    style="@style/takFieldStyle"
                    android:hint="50"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <Button
                android:id="@+id/uasfmUseLocationButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Use My Location"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
            <Button
                android:id="@+id/uasfmCheckButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Check Size"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/uasfmDownloadButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Download"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0" />
            <Button
                android:id="@+id/uasfmClearButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear Data"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B71C1C" />
        </LinearLayout>

        <TextView
            android:id="@+id/uasfmStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:textColor="#B0B0B0"
            android:textSize="13sp"
            android:text="" />

    </LinearLayout>
</ScrollView>

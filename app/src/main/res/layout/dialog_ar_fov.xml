<?xml version="1.0" encoding="utf-8"?>
<!-- AR field-of-view calibration (TAKPilot2GoFlightActivity.onArCalibrateTapped). Adjusts live
     while the overlay is running so the pilot can watch a marker converge onto the real object.
     Text colours hardcoded — inflated via the Activity's own layoutInflater, not the dialog's,
     same as dialog_drop_pin.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Put a marker on something you can identify, aim so it sits near the EDGE of frame, then adjust until the icon sits on it. Error is invisible at centre and grows toward the edges, so the edge is where this is measured."
        android:textColor="#B0B0B0"
        android:textSize="12sp"
        android:paddingBottom="12dp" />

    <LinearLayout style="@style/takFormRow">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Horizontal"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
        <Button
            android:id="@+id/arFovHMinus"
            style="@style/takFovStepButton"
            android:text="−" />
        <TextView
            android:id="@+id/arFovHValue"
            style="@style/takFovValue" />
        <Button
            android:id="@+id/arFovHPlus"
            style="@style/takFovStepButton"
            android:text="+" />
    </LinearLayout>

    <LinearLayout style="@style/takFormRow" android:layout_marginTop="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Vertical"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
        <Button
            android:id="@+id/arFovVMinus"
            style="@style/takFovStepButton"
            android:text="−" />
        <TextView
            android:id="@+id/arFovVValue"
            style="@style/takFovValue" />
        <Button
            android:id="@+id/arFovVPlus"
            style="@style/takFovStepButton"
            android:text="+" />
    </LinearLayout>

    <TextView
        android:id="@+id/arFovHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#9AC4FF"
        android:textSize="12sp" />
</LinearLayout>

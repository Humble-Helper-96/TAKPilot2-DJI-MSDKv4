<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/tp_bg_home"
    android:padding="20dp"
    android:baselineAligned="false">

    <!-- LEFT: options column -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Debug Log"
            android:textColor="@color/tp_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout style="@style/homeCard">
            <TextView style="@style/homeCardTitle" android:text="Options" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="6dp">
                <CheckBox android:id="@+id/debugLoggingToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="@color/tp_btn_info" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Logging enabled" android:textColor="@color/tp_text_bright" android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="4dp">
                <CheckBox android:id="@+id/debugVerboseToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="@color/tp_btn_info" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Detailed (all app functions)" android:textColor="@color/tp_text_bright" android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="4dp">
                <CheckBox android:id="@+id/debugTakToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="@color/tp_btn_info" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Include TAK / CoT logs" android:textColor="@color/tp_text_bright" android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:paddingTop="2dp"
                android:text="Clear this box to hide the TAK messages and show only the app."
                android:textColor="@color/tp_text_caption" android:textSize="12sp" />

            <!-- Obstacle-distance filter, ported from the Autel build's radar toggle. The vision
                 sensors report continuously, so these are the highest-volume lines the app
                 writes; off by default. The help text promises that avoidance changes and
                 warnings survive the filter — that promise is kept structurally, by putting the
                 noisy readout on its own log tag (see AppLog.OBSTACLE_TAGS). -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="4dp">
                <CheckBox android:id="@+id/debugObstacleToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="@color/tp_btn_info" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Include obstacle distance logs" android:textColor="@color/tp_text_bright" android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:paddingTop="2dp"
                android:text="The sensors fill the log. Select this box only to examine obstacle avoidance. Avoidance changes and warnings stay in the log."
                android:textColor="@color/tp_text_caption" android:textSize="12sp" />

            <Button
                android:id="@+id/debugExportButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Export Log"
                android:textColor="@color/tp_text_primary"
                android:backgroundTint="@color/tp_btn_primary" />
            <Button
                android:id="@+id/debugClearButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Clear Log"
                android:textColor="@color/tp_text_primary"
                android:backgroundTint="@color/tp_btn_neutral" />
            <Button
                android:id="@+id/debugDeleteButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Delete Log"
                android:textColor="@color/tp_text_primary"
                android:backgroundTint="@color/tp_btn_danger" />
        </LinearLayout>

        <TextView
            android:id="@+id/debugLogMeta"
            style="@style/homeCardSub"
            android:layout_marginTop="10dp"
            android:text="" />

        <TextView
            style="@style/homeCardSub"
            android:layout_marginTop="4dp"
            android:text="Also archived to Downloads/TAKPilot2 Logs" />

    </LinearLayout>
    </ScrollView>

    <!-- RIGHT: live-scrolling log view -->
    <ScrollView
        android:id="@+id/debugLogScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.4"
        android:background="@color/tp_surface_card"
        android:padding="12dp">

        <TextView
            android:id="@+id/debugLogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/tp_state_go_soft"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:text="" />
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tp_bg_flight">

    <com.dji.sdk.sample.takpilot2.FpvTextureView
        android:id="@+id/flightFpvView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- AR marker overlay. BELOW the crosshair deliberately: the crosshair is the aiming
         reference for marker drops and must never be occluded by a projected marker. Hidden
         until the pilot turns it on. -->
    <com.dji.sdk.sample.takpilot2.ArOverlayView
        android:id="@+id/flightArOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.dji.sdk.sample.takpilot2.CrosshairView
        android:id="@+id/flightCrosshair"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Obstacle proximity arcs/chevrons on the edges of the VIDEO (not the view — it sizes
         itself from the same videoRect the crosshair uses, so nothing lands under the HUD
         column). Above the crosshair so a close-range warning is never occluded by it, below
         the toolbar and diagnostics banner. Draws nothing at all on an aircraft without
         obstacle sensors (Mini 2). -->
    <com.dji.sdk.sample.takpilot2.ObstacleEdgeView
        android:id="@+id/flightObstacles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/flightNoVideoCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tp_bg_screen"
        android:gravity="center"
        android:text="Waiting for video…"
        android:textColor="@color/tp_text_disabled"
        android:textSize="16sp"
        android:visibility="visible" />

    <!-- Transient notice ("Home Point Set", etc.) — upper-left over the video, below the
         toolbar. Hidden by default; shown + auto-hidden in code. -->
    <TextView
        android:id="@+id/fpvNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:shadowColor="@color/tp_shadow"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text=""
        android:textColor="@color/tp_state_go"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Aircraft diagnostics banner: the aircraft's OWN reasons it won't do something (no-fly
         zone, compass error, IMU calibration, battery fault) — the red text DJI Fly shows and
         this app previously showed nowhere at all. Added 2026-08-03 after a motors-won't-start
         investigation cost two flights guessing, when the aircraft had been reporting "Cannot
         takeoff in a no-fly zone" the whole time with nothing listening.

         TOP-LEFT, and the transient notice is TOP-CENTRE (specification §4.8). They are two
         different things in two different places and must never share a slot, because both can
         be on screen at once. Top-left and not top-centre because top-centre covers the part of
         the picture the pilot works with; the banner's colour still interrupts from the corner.
         maxWidth keeps a long multi-fault message wrapping into the video area instead of
         running under the HUD.

         Moved from 88dp to 64dp and restyled 2026-08-14 (conformance D5) to match the Autel
         sibling: white 15sp bold on a background the activity tints by severity, instead of
         tinted text on a fixed dark-red backing. -->
    <!-- A ROW since v1.2.13 (specification §4.8's two slots, ported from the Autel tree
         2026-09-14): the text opens to every warning on a tap and closes on the ✕. This row is a
         later child than flightCrosshair, thus it draws above it and TAKES the touch — a tap on
         a warning never falls through to the video and drops a marker. A close hides one SET of
         warnings and never the banner: the activity remembers what was closed and a change to
         the live set brings the banner back — see warningDismissedSignature. -->
    <LinearLayout
        android:id="@+id/flightWarningRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="64dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_warning_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/flightDiagnostics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.03"
            android:maxWidth="@dimen/flight_warning_max_width"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text=""
            android:textColor="@color/tp_text_primary"
            android:textSize="@dimen/flight_warning_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/flightWarningClose"
            android:layout_width="@dimen/flight_warning_close_size"
            android:layout_height="@dimen/flight_warning_close_size"
            android:contentDescription="Close this warning"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/tp_text_primary"
            android:textSize="@dimen/flight_warning_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- DEBUG resource overlay: memory, CPU and the TAK contact count. Hidden unless switched
         on in the Debug screen, and off by default — it covers live video.

         Bottom-left, clear of the HUD column via marginEnd, because the bottom-left of this
         screen is the one region with neither chrome nor crosshair on it. Four cells, not the
         sibling's five: there is no GPU cell because there is no GPU read. -->
    <LinearLayout
        android:id="@+id/flightResourceMonitorRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="@dimen/flight_resource_row_margin_end"
        android:background="#B0000000"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView android:id="@+id/flightResSys" style="@style/flightResCell" />
        <TextView android:id="@+id/flightResApp" style="@style/flightResCell" />
        <TextView android:id="@+id/flightResCpu" style="@style/flightResCell" />
        <TextView android:id="@+id/flightResTak" style="@style/flightResCell" />
    </LinearLayout>

    <!-- ATAK-UAS-Tool-style telemetry overlay, stacked directly above the mini-map (same
         bottom|end corner/size/margin the map already had — "leave the mini map where it is").
         Plain text over video, no box, to match the reference look. -->
    <!-- RIGHT-HAND HUD COLUMN.
         Exposure + telemetry + map in ONE container, deliberately. These were previously two
         independently-anchored children (exposure top|end, telemetry bottom|end); as the readout
         grew they silently grew INTO each other and ISO/shutter printed over the lat/lon.
         Nothing warns you about that — it just renders wrong. Stacked in one LinearLayout with a
         weighted spacer, the layout engine guarantees they cannot overlap at any screen size and
         the spacer absorbs whatever height is left over.

         Sits over the pillarbox to the right of the 16:9 video, not over the image itself. -->
    <LinearLayout
        android:id="@+id/flightHudColumn"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingTop="45dp"
        android:paddingBottom="0dp"
        android:paddingEnd="14dp">
        <!-- paddingBottom is 0 (operator, 2026-09-14): the map's bottom edge lines up with the
             picture's, which fills the full 1080px here. The phone's rounded screen corner
             reaches about 6px into that spot, under the map's own 8dp corner. Per-device — the
             siblings keep an inset. -->

        <!-- TOP HUD PANEL: exposure controls, clock, telemetry and gimbal, on one
             translucent backing. Ported from the Autel sibling 2026-08-14 (conformance D4,
             specification §4.3).

             WHY A PANEL: this text sits over live video whose brightness the pilot does not
             control, and light ground — snow, wet asphalt, a white roof — washes bare text out.
             The drop shadow in hudText helps and is not enough by itself.

             PANEL WIDTH IS THE MAP'S WIDTH, not wrap_content: the map is the widest thing in
             this column, and matching it keeps the exposure block, the readouts and the map
             flush on one right edge as a single instrument stack. Letting it wrap would push
             the panel past the map on its padding alone, which reads as a misalignment.
             Children are match_parent so they inset with the panel's padding. -->
        <!-- ⚠ THE TRANSLUCENT PANEL IS GONE (specification §4.3) and the readouts carry a BLACK
             OUTLINE instead === see OutlinedTextView. The panel stopped white text washing out
             over snow, wet asphalt or a white roof, and it worked, but it covered live video the
             pilot flies from; its opacity was walked 55 % to 40 % to 20 % on the Autel sibling
             chasing that trade. An outline is legible on any background and covers only the
             pixels around the glyphs.

             ⚠ REMOVING A BACKGROUND SILENTLY REMOVES ITS PADDING. bg_hud_panel supplied 8dp on
             each side and 4dp top and bottom. The HORIZONTAL 8dp is restored explicitly, because
             the block's width is the map's width and the children inset within it. The VERTICAL
             4dp is deliberately NOT restored: it existed to hold the text off the panel's edge,
             there is no panel now, and this is the SHORTEST screen of the three === that 16dp is
             what pays for the outline's own padding. See the budget in dimens.xml. -->
        <LinearLayout
            android:layout_width="@dimen/flight_map_size"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="8dp">

            <!-- paddingStart 2dp, not 8 (operator, 2026-09-14): the slider's left end sat 11dp
                 off the picture; now about 5dp. The right padding stays 8, it is what the
                 readouts' outline needs. -->
            <!-- EV compensation slider biasing the shutter-priority auto-ISO, with the live
                 ISO/shutter the camera actually chose beneath it.

                 ⚠ match_parent, NOT @dimen/flight_map_size. The BLOCK is the map's width and
                 carries 8dp of padding on each side, so a child given the map's width is 16dp
                 wider than the space it has. The block sets gravity="end", thus the overflow
                 went off the LEFT and clipped the "-2" label clean in half (operator,
                 2026-08-18). match_parent insets the child within the padding.

                 That 8dp came from bg_hud_panel until 2026-09-13 and is now explicit on the
                 block === the fault this note describes is unchanged, and so is the fix. -->
            <com.dji.sdk.sample.takpilot2.EvSliderView
                android:id="@+id/evSlider"
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.dji.sdk.sample.takpilot2.OutlinedTextView style="@style/flightReadoutText" android:layout_width="0dp"
                    android:layout_weight="1" android:gravity="start" android:text="-2" />

                <com.dji.sdk.sample.takpilot2.OutlinedTextView style="@style/flightReadoutText" android:layout_width="0dp"
                    android:layout_weight="1" android:gravity="center"
                    android:letterSpacing="0.08" android:text="EV" android:textColor="@color/tp_accent" />

                <com.dji.sdk.sample.takpilot2.OutlinedTextView style="@style/flightReadoutText" android:layout_width="0dp"
                    android:layout_weight="1" android:gravity="end" android:text="+2" />
            </LinearLayout>

            <!-- CAMERA MEDIA MODE, under the exposure block (specification §4.3, ledger D22;
                 ported from the Autel tree 2026-09-14).

                 ⚠ IT IS A READOUT AND NOT A CONTROL, AND THE DIFFERENCE IS THE WHOLE POINT.
                 Outlined glyph and word with no backing, like every other readout. A pill would
                 say "touch me", and this application does not drive the media mode: the RC-N1's
                 photo/video switch and its shutter move the camera without this application
                 being asked, and the picture changes shape and field of view with it — 4:3
                 against 16:9. Giving the pilot the FACT costs nothing; a control would be a new
                 write to the camera.

                 WHY IT IS HERE: the mode changes how the picture LOOKS, as EV does, so it sits
                 with the exposure controls and not in the actions capsule.

                 ⚠ UNKNOWN IS ITS OWN STATE. Amber "? MODE" until the camera answers.

                 ⚠ HEIGHT — MEASURED 2026-09-14 (ledger D20/D22). This is the SHORTEST screen of
                 the three. The column had 12px of slack at v1.2.4; this view is 45px and the
                 position line leaving the telemetry block (§4.4) with MSL receding gave 38px
                 back, so with a 2dp margin the spacer measured EXACTLY 0px — on the map's clip
                 edge. NO MARGIN here (its own outline padding is 4px) and the gimbal line's
                 margin below trimmed, to hold about 10px. Not the Autel tree's 6dp — §7. -->
            <com.dji.sdk.sample.takpilot2.MediaModeView
                android:id="@+id/fpvMediaMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end" />

            <!-- Wall clock. Right-aligned and directly above the telemetry block so it reads as
                 part of the readouts, not as a label on the EV slider. The flight screen is
                 full-screen and covers the system status bar, so without this there is no time
                 anywhere on it, and the time is what a pilot writes in a log, calls on the radio,
                 and matches against the flight record afterwards. Seconds included: the HUD ticks
                 at 500ms, so the digit is live for a pilot timing a leg. -->
            <com.dji.sdk.sample.takpilot2.OutlinedTextView
                android:id="@+id/fpvClock"
                style="@style/flightReadoutText"
                android:layout_marginBottom="2dp"
                android:gravity="end"
                android:text="00:00:00" />

            <com.dji.sdk.sample.takpilot2.OutlinedTextView
                android:id="@+id/fpvOverlayText"
                style="@style/flightReadoutText"
                android:layout_marginBottom="4dp"
                android:gravity="end"
                android:text="" />

            <!-- Gimbal look angle, its own view so it can carry the same accuracy colour as the
                 crosshair centre ring: placement error scales as 1/sin^2(pitch), so a shallow angle
                 is a real accuracy warning rather than decoration. See updateGimbalPitch. -->
            <!-- 2dp, not 4dp, since v1.2.5: the media-mode readout above needed the height —
                 see its note. This is the last view in the top block, so the margin only sets
                 the gap to the weighted spacer. -->
            <com.dji.sdk.sample.takpilot2.OutlinedTextView
                android:id="@+id/fpvGimbalPitch"
                style="@style/flightReadoutText"
                android:layout_marginBottom="2dp"
                android:gravity="end"
                android:text="" />
        </LinearLayout>

        <!-- Absorbs leftover height so the TOP group and the BOTTOM group sit at opposite ends
             of the column instead of packing together in the middle. That middle band is where
             the obstacle-radar distance labels render; with everything clustered there the
             radar text was unreadable on the sibling. The spacer also makes overlap impossible
             at any screen size. -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- BOTTOM HUD BLOCK, pinned above the map: RTH, HOME, FAA. Order is fixed by
             specification §4.3. The panel is gone here for the same reason as the top block ===
             see the note there, including why the vertical padding is not restored. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">


            <!-- RTH height AS THE AIRCRAFT REPORTS IT, not as Pre-Flight requested. A set can be
                 accepted and not applied, or rejected while the screen keeps showing the number the
                 pilot typed. This is the one a pilot is about to rely on. Shows a dashed placeholder
                 until the aircraft has answered, because unknown must not look like a value. -->
            <!-- ⚠ TIGHT ON PURPOSE (operator, 2026-09-14): no margins between these three lines
                 and no font padding, so the bottom block spends as little height as three short
                 lines can. The outline's own half-stroke padding in OutlinedTextView is what
                 keeps the stroke off the clip edge. Measured, not computed — see D20. -->
            <com.dji.sdk.sample.takpilot2.OutlinedTextView
                android:id="@+id/fpvRthAltitude"
                style="@style/flightReadoutText"
                android:includeFontPadding="false"
                android:layout_marginBottom="0dp"
                android:gravity="end"
                android:text="RTH --" />

            <!-- Home distance and bearing. Moved out of the telemetry block and down here, under
                 RTH: the two belong together — how far home is, and how high the aircraft will
                 climb to get there. -->
            <com.dji.sdk.sample.takpilot2.OutlinedTextView
                android:id="@+id/fpvHomeDistance"
                style="@style/flightReadoutText"
                android:includeFontPadding="false"
                android:layout_marginBottom="0dp"
                android:gravity="end"
                android:text="HOME" />

            <!-- FAA UASFM ceiling; own view so it can turn amber/red independently. Advisory. -->
            <com.dji.sdk.sample.takpilot2.OutlinedTextView
                android:id="@+id/fpvFaaCeiling"
                style="@style/flightReadoutText"
                android:includeFontPadding="false"
                android:layout_marginBottom="0dp"
                android:gravity="end"
                android:text=""
                android:visibility="gone" />
        </LinearLayout>

        <!-- The map lives in a container so the zoom toggle can sit ON it. The double-tap
             expansion resizes THIS, not the MapView, so the button scales with it. -->
        <FrameLayout
            android:id="@+id/flightMapContainer"
            android:layout_width="@dimen/flight_map_size"
            android:layout_height="@dimen/flight_map_height"
            android:foreground="@drawable/bg_map_outline">

            <!-- ⚠ mapbox_renderTextureMode="true" IS LOAD-BEARING FOR THE ROUNDED CORNERS.
                 In texture mode this map renders into a TextureView, which is drawn into the
                 ordinary view hierarchy and CAN be clipped by the container's outline. In the
                 default surface mode it renders into a SurfaceView, which the system composites
                 separately === a parent's outline clip does not touch it, so the corners would go
                 back to square while the border stayed rounded, with no error anywhere.

                 The flag was already set here before the corners needed it, for a reason this
                 tree does not record. Do not remove it without checking the map corners AND
                 finding out what else it was for. Specification §4.9 names this trap. -->
            <com.mapbox.mapboxsdk.maps.MapView
                android:id="@+id/flightMapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:mapbox_renderTextureMode="true" />

            <!-- WIDE/NEAR toggle. Bottom-left, same corner as the sibling — free now that
                 MapLibre's (incorrect) Mapbox badge is switched off; see the flight activity.
                 Sized to THIS map, not copied: 36x22dp on a 130dp map is the same proportion
                 as the sibling's 48x32 on its 180dp one. There is not much room here. -->
            <TextView
                android:id="@+id/flightMapZoomButton"
                android:layout_width="36dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="4dp"
                android:background="@drawable/bg_map_zoom_button"
                android:contentDescription="Mini-map zoom"
                android:gravity="center"
                android:text="WIDE"
                android:textColor="@color/tp_text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

    </LinearLayout>


    <!-- Instrument toolbar: TAKPilot2's blue chrome, houses status readouts + flight actions.
         Solid bar overlaid on the video (not letterboxed space) — same overlay-on-FPV pattern
         already used by the HUD/status bars below. -->
    <!-- ⚠ THE BAND IS TRANSPARENT AND KEEPS THE flightToolbar ID ON PURPOSE.
         The AR overlay and the obstacle-edge view read this view's HEIGHT as their top chrome
         inset, so that an edge arrow or a proximity label cannot be parked where the chrome
         hides it === the case that matters most is the aircraft directly overhead. Splitting the
         bar into two capsules without keeping a view that reports the band's height would have
         broken both, silently. The band draws nothing; the two capsules inside it do. -->
    <LinearLayout
        android:id="@+id/flightToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="5dp">

        <!-- STATUS, left. Specification §4.2 fixes the order: back, TAK, battery, signal, GPS,
             RTH. The capsule is what separates these from the video now. -->
        <LinearLayout
            android:id="@+id/flightToolbarStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_capsule"
            android:gravity="center_vertical"
            android:minHeight="@dimen/hud_capsule_height"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp">

        <ImageButton
            android:id="@+id/flightBackButton"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu (home)"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu" />

        <View android:layout_width="6dp" android:layout_height="1dp" />

        <!-- TAK connection state sits first in the status cluster, immediately after the menu
             button: it gates everything else this screen does with the server, so it reads
             before battery/signal/GPS rather than after them. -->
        <FrameLayout
            android:id="@+id/toolbarTakButton"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle TAK server connection">

            <!-- The real TAK mark already contains the wordmark, so the old hand-drawn shield
                 silhouette + separate "TAK" TextView overlay is gone. -->
            <ImageView
                android:id="@+id/toolbarTakIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:scaleType="fitCenter"
                android:contentDescription="TAK server connection"
                android:src="@drawable/ic_tak_logo" />

            <ImageView
                android:id="@+id/toolbarTakDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="bottom|start"
                android:src="@drawable/bg_status_dot" />

        </FrameLayout>

        <com.dji.sdk.sample.takpilot2.BatteryGaugeView
            android:id="@+id/toolbarBattery"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Battery" />

        <com.dji.sdk.sample.takpilot2.SignalBarsView
            android:id="@+id/toolbarSignal"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="RC signal strength" />

        <TextView
            android:id="@+id/toolbarSignalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="14dp"
            android:alpha="0.4"
            android:text="—%"
            android:textColor="@color/tp_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/toolbarGpsIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="GPS satellites"
            android:src="@drawable/ic_gps" />

        <TextView
            android:id="@+id/toolbarGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="14dp"
            android:text="—"
            android:textColor="@color/tp_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/flightRthButton"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:layout_marginEnd="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Return to home"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_rth" />

        </LinearLayout>

        <!-- The gap. It holds the actions capsule against the right edge and leaves the middle
             of the band as picture. See the two capsules' minHeight for why they sit level. -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- ACTIONS, right. Drop-pin, AR, shutter, zoom, re-sync, LIVE, REC. This is the ONE
             tree that keeps the shutter pill === specification §4.2 closes that slot wherever the
             body has a shutter button, and this target is a phone. -->
        <LinearLayout
            android:id="@+id/flightToolbarActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_capsule"
            android:gravity="center_vertical"
            android:minHeight="@dimen/hud_capsule_height"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp">

        <!-- Drop-pin heads the right-hand cluster and is deliberately the LARGEST control in the
             bar: it is the most-used action on this screen, and a pilot reaching for it is
             usually also flying, so it has to be findable and hittable without aiming. AR sits
             immediately after it — drop-pin creates markers, AR shows them, so they read as a
             pair either way round. -->
        <ImageButton
            android:id="@+id/flightDropPinButton"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Drop a TAK marker at the camera crosshair"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_drop_pin" />

        <!-- Tap toggles the AR overlay; long-press opens the AR options (6D-C). -->
        <TextView
            android:id="@+id/flightArButton"
            android:layout_width="54dp"
            android:layout_height="26dp"
            android:layout_marginStart="@dimen/hud_pill_gap"
            android:background="@drawable/bg_zoom_pill"
            android:contentDescription="Toggle AR marker overlay"
            android:gravity="center"
            android:text="AR"
            android:textColor="@color/tp_text_primary"
            android:textSize="@dimen/hud_pill_text_size"
            android:textStyle="bold" />

        <!-- THE SHUTTER SLOT IS CLOSED (operator, 2026-09-14, v1.2.11). The RC-N1 has a
             photo/video button and a shutter, both measured working (ledger D26), and the REC
             pill is a shutter whenever the camera is in stills (D25) — the on-screen shutter
             was a third way to do the same thing, and its PHOTO_SINGLE -> shoot -> VIDEO mode
             dance was the path that once stranded a camera in photo mode (2026-08-03). -->

        <TextView
            android:id="@+id/flightZoomButton"
            android:layout_width="54dp"
            android:layout_height="26dp"
            android:layout_marginStart="@dimen/hud_pill_gap"
            android:background="@drawable/bg_zoom_pill"
            android:contentDescription="Toggle camera zoom (1x/2x)"
            android:gravity="center"
            android:text="1X"
            android:textColor="@color/tp_text_primary"
            android:textSize="@dimen/hud_pill_text_size"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/flightResyncButton"
            android:layout_width="54dp"
            android:layout_height="26dp"
            android:layout_marginStart="@dimen/hud_pill_gap"
            android:background="@drawable/bg_zoom_pill"
            android:contentDescription="Video re-sync"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_resync" />

        <com.dji.sdk.sample.takpilot2.LiveToggleView
            android:id="@+id/flightStreamButton"
            android:layout_width="66dp"
            android:layout_height="26dp"
            android:layout_marginStart="@dimen/hud_pill_gap"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Start/stop live stream (not wired yet)" />

        <com.dji.sdk.sample.takpilot2.RecordToggleView
            android:id="@+id/flightRecordButton"
            android:layout_width="66dp"
            android:layout_height="26dp"
            android:layout_marginStart="@dimen/hud_pill_gap"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Start/stop recording to SD (not wired yet)" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>

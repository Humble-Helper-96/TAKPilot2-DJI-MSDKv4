<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.dji.sdk.sample.takpilot2.FpvTextureView
        android:id="@+id/flightFpvView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- AR marker overlay. BELOW the crosshair deliberately: the crosshair is the aiming
         reference for marker drops and must never be occluded by a projected marker. Hidden
         until the pilot turns it on. -->
    <com.dji.sdk.sample.takpilot2.ArOverlayView
        android:id="@+id/flightArOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.dji.sdk.sample.takpilot2.CrosshairView
        android:id="@+id/flightCrosshair"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/flightNoVideoCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1A1A1A"
        android:gravity="center"
        android:text="Waiting for video…"
        android:textColor="#666666"
        android:textSize="16sp"
        android:visibility="visible" />

    <!-- Transient notice ("Home Point Set", etc.) — upper-left over the video, below the
         toolbar. Hidden by default; shown + auto-hidden in code. -->
    <TextView
        android:id="@+id/fpvNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="64dp"
        android:layout_marginStart="16dp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text=""
        android:textColor="#4CAF50"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- ATAK-UAS-Tool-style telemetry overlay, stacked directly above the mini-map (same
         bottom|end corner/size/margin the map already had — "leave the mini map where it is").
         Plain text over video, no box, to match the reference look. -->
    <!-- RIGHT-HAND HUD COLUMN.
         Exposure + telemetry + map in ONE container, deliberately. These were previously two
         independently-anchored children (exposure top|end, telemetry bottom|end); as the readout
         grew they silently grew INTO each other and ISO/shutter printed over the lat/lon.
         Nothing warns you about that — it just renders wrong. Stacked in one LinearLayout with a
         weighted spacer, the layout engine guarantees they cannot overlap at any screen size and
         the spacer absorbs whatever height is left over.

         Sits over the pillarbox to the right of the 16:9 video, not over the image itself. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingTop="60dp"
        android:paddingBottom="12dp"
        android:paddingEnd="14dp">

        <!-- EV compensation slider biasing the shutter-priority auto-ISO, with the live
             ISO/shutter the camera actually chose beneath it.

             Width is the MAP's width, not a number of its own: the map is the widest thing in
             this column, so matching it is what makes the exposure block, the readouts and the
             map read as one right-hand instrument stack instead of the slider hanging out over
             the video. It also tracks the h440dp dimen override for free. -->
        <com.dji.sdk.sample.takpilot2.EvSliderView
            android:id="@+id/evSlider"
            android:layout_width="@dimen/flight_map_size"
            android:layout_height="24dp" />

        <LinearLayout
            android:layout_width="@dimen/flight_map_size"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView style="@style/hudText" android:layout_width="0dp"
                android:layout_weight="1" android:gravity="start" android:text="-2" />

            <TextView style="@style/hudText" android:layout_width="0dp"
                android:layout_weight="1" android:gravity="center"
                android:letterSpacing="0.08" android:text="EV" android:textColor="#9AC4FF" />

            <TextView style="@style/hudText" android:layout_width="0dp"
                android:layout_weight="1" android:gravity="end" android:text="+2" />
        </LinearLayout>

        <TextView
            android:id="@+id/exposureReadout"
            style="@style/hudText"
            android:layout_width="@dimen/flight_map_size"
            android:gravity="center"
            android:text="ISO —   —" />

        <!-- Absorbs leftover height: exposure stays pinned to the top, the rest to the bottom,
             and neither can run into the other. -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/fpvOverlayText"
            style="@style/hudText"
            android:layout_marginBottom="4dp"
            android:gravity="end"
            android:text="" />

        <!-- Gimbal look angle, its own view so it can carry the same accuracy colour as the
             crosshair centre ring: placement error scales as 1/sin^2(pitch), so a shallow angle
             is a real accuracy warning rather than decoration. See updateGimbalPitch. -->
        <TextView
            android:id="@+id/fpvGimbalPitch"
            style="@style/hudText"
            android:layout_marginBottom="4dp"
            android:gravity="end"
            android:text="" />

        <!-- FAA UASFM ceiling; own view so it can turn amber/red independently. Advisory. -->
        <TextView
            android:id="@+id/fpvFaaCeiling"
            style="@style/hudText"
            android:layout_marginBottom="6dp"
            android:gravity="end"
            android:text=""
            android:visibility="gone" />

        <com.mapbox.mapboxsdk.maps.MapView
            android:id="@+id/flightMapView"
            android:layout_width="@dimen/flight_map_size"
            android:layout_height="@dimen/flight_map_size"
            app:mapbox_renderTextureMode="true" />

    </LinearLayout>


    <!-- Instrument toolbar: TAKPilot2's blue chrome, houses status readouts + flight actions.
         Solid bar overlaid on the video (not letterboxed space) — same overlay-on-FPV pattern
         already used by the HUD/status bars below. -->
    <LinearLayout
        android:id="@+id/flightToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/flightBackButton"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu (home)"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu" />

        <View android:layout_width="6dp" android:layout_height="1dp" />

        <!-- TAK connection state sits first in the status cluster, immediately after the menu
             button: it gates everything else this screen does with the server, so it reads
             before battery/signal/GPS rather than after them. -->
        <FrameLayout
            android:id="@+id/toolbarTakButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle TAK server connection">

            <!-- The real TAK mark already contains the wordmark, so the old hand-drawn shield
                 silhouette + separate "TAK" TextView overlay is gone. -->
            <ImageView
                android:id="@+id/toolbarTakIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="fitCenter"
                android:contentDescription="TAK server connection"
                android:src="@drawable/ic_tak_logo" />

            <ImageView
                android:id="@+id/toolbarTakDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|start"
                android:src="@drawable/bg_status_dot" />

        </FrameLayout>

        <com.dji.sdk.sample.takpilot2.BatteryGaugeView
            android:id="@+id/toolbarBattery"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Battery" />

        <com.dji.sdk.sample.takpilot2.SignalBarsView
            android:id="@+id/toolbarSignal"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="RC signal strength" />

        <TextView
            android:id="@+id/toolbarSignalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="14dp"
            android:alpha="0.4"
            android:text="—%"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/toolbarGpsIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="GPS satellites"
            android:src="@drawable/ic_gps" />

        <TextView
            android:id="@+id/toolbarGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="14dp"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/flightRthButton"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:layout_marginEnd="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Return to home"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_rth" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Drop-pin heads the right-hand cluster and is deliberately the LARGEST control in the
             bar: it is the most-used action on this screen, and a pilot reaching for it is
             usually also flying, so it has to be findable and hittable without aiming. AR sits
             immediately after it — drop-pin creates markers, AR shows them, so they read as a
             pair either way round. -->
        <ImageButton
            android:id="@+id/flightDropPinButton"
            android:layout_width="56dp"
            android:layout_height="46dp"
            android:layout_marginEnd="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Drop a TAK marker at the camera crosshair"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_drop_pin" />

        <!-- Tap toggles the AR overlay; long-press opens the AR options (6D-C). -->
        <TextView
            android:id="@+id/flightArButton"
            android:layout_width="36dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_zoom_pill"
            android:contentDescription="Toggle AR marker overlay"
            android:gravity="center"
            android:text="AR"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/flightShootPhotoButton"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Take photo (saves to aircraft SD card)"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera_shutter" />

        <TextView
            android:id="@+id/flightZoomButton"
            android:layout_width="36dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_zoom_pill"
            android:contentDescription="Toggle camera zoom (1x/2x)"
            android:gravity="center"
            android:text="1X"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/flightResyncButton"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Video re-sync"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_resync" />

        <com.dji.sdk.sample.takpilot2.LiveToggleView
            android:id="@+id/flightStreamButton"
            android:layout_width="82dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Start/stop live stream (not wired yet)" />

        <com.dji.sdk.sample.takpilot2.RecordToggleView
            android:id="@+id/flightRecordButton"
            android:layout_width="74dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Start/stop recording to SD (not wired yet)" />

    </LinearLayout>

</FrameLayout>

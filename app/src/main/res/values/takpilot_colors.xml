<?xml version="1.0" encoding="utf-8"?>
<!--
  TAKPilot2 colour tokens — the single source of truth for the pilot-facing screens.

  WHY. Before this, every colour was an inline #RRGGBB literal repeated across layouts,
  styles.xml and Kotlin, with no shared names: 68 Color.parseColor call sites over 32 distinct
  values, several of them near-duplicate greys that no longer agreed with each other. This file
  names each colour by its ROLE so the same role always uses the same value, and a change is made
  in one place. Reference these as @color/tp_* from layouts and styles, and through
  ContextCompat.getColor from code.

  VALUES ARE PRESERVED from the pre-token palette, with exactly three exceptions, all recorded
  here so nobody has to diff for them:
    #AAAAAA -> #B0B0B0  secondary text  (two greys 6/255 apart, sub-perceptual)
    #E0E0E0 -> #DDDDDD  bright text     (3/255 apart, sub-perceptual)
    #555555 -> #37474F  the Log Out button, folded onto the neutral button role like its
                        siblings — see the comment at that button in activity_tak_connect.xml
  The first two are the near-duplicate consolidation this file exists to make impossible to
  reintroduce; the third is a deliberate role fix. Nothing else moved.

  ⚠ res/values/colors.xml IS NOT THIS FILE. That one belongs to the stock DJI sample and is
  consumed by its demo views; leave it alone. Everything TAKPilot draws comes from here.

  ⚠ THE FLIGHT-HUD VIEWS ARE INCLUDED, DELIBERATELY. The Autel sibling introduced its token file
  without them and that gap is still an open finding in its own audit — roughly fifty literals
  that outlived the consolidation they were supposed to be part of. The HUD colours below carry a
  FLIGHT-TUNED marker: their values were chosen against live video and must be tokenised without
  being re-tuned. Change one only with the aircraft in front of you.
-->
<resources>

    <!-- Surfaces / backgrounds -->
    <color name="tp_bg_home">#0E0E10</color>        <!-- home screen root -->
    <color name="tp_bg_flight">#000000</color>      <!-- flight screen root (under the video) -->
    <color name="tp_bg_screen">#1A1A1A</color>      <!-- pre-flight / general screen bg -->
    <color name="tp_bg_data_sync">#0E1116</color>   <!-- data-sync screen bg -->
    <color name="tp_surface_card">#1A1B1E</color>   <!-- raised card on the home screen -->
    <color name="tp_surface_row">#1A1F26</color>    <!-- data-sync list row -->
    <color name="tp_surface_field">#2A2A2A</color>  <!-- text-input background -->
    <color name="tp_surface_dialog">#202020</color> <!-- dialog background -->
    <color name="tp_surface_guide">#202024</color>  <!-- field-guide section block -->
    <color name="tp_surface_guide_code">#101014</color> <!-- field-guide inset/example block -->
    <color name="tp_surface_guide_note">#14202C</color> <!-- field-guide note callout background -->
    <color name="tp_surface_guide_warn">#2A1616</color> <!-- field-guide warning callout background -->
    <color name="tp_border">#333333</color>         <!-- hairline borders / dim separators -->
    <color name="tp_divider">#33FFFFFF</color>      <!-- translucent-white divider -->

    <!-- Text (a muted-grey scale, brightest first) -->
    <color name="tp_text_primary">#FFFFFF</color>
    <color name="tp_text_bright">#DDDDDD</color>    <!-- checkbox labels (debug screen) -->
    <color name="tp_text_light">#CFCFCF</color>     <!-- body copy (field guide) -->
    <color name="tp_text_secondary">#B0B0B0</color> <!-- status lines, secondary labels -->
    <color name="tp_text_tertiary">#909090</color>
    <color name="tp_text_cool">#9AA4B2</color>      <!-- data-sync captions (cool-tinted grey) -->
    <color name="tp_text_muted">#9A9A9A</color>     <!-- captions -->
    <color name="tp_text_hint">#777777</color>      <!-- input hint -->
    <!-- Hint text inside a DIALOG, lighter than tp_text_hint on purpose: #777777
         measured too dim against the dialog background on the controller screen.
         Consumed by the Autel tree today; defined in all three so the name cannot
         come to mean two colours. -->
    <color name="tp_text_hint_dialog">#8A93A0</color>
    <color name="tp_text_caption">#7A7A7A</color>   <!-- sub-labels under a setting -->
    <color name="tp_text_disabled">#666666</color>  <!-- disabled / placeholder -->
    <color name="tp_text_dim">#D8D8D8</color>       <!-- dialog body on dark -->
    <color name="tp_text_warn">#E8B04B</color>      <!-- field-guide caution callout -->

    <!-- Accent — the one "interactive / link" blue -->
    <color name="tp_accent">#9AC4FF</color>

    <!-- Button backgrounds (roles, not statuses) -->
    <color name="tp_btn_primary">#2E7D32</color>       <!-- primary / go -->
    <color name="tp_btn_info">#1565C0</color>          <!-- informational; also checkbox tint -->
    <color name="tp_btn_neutral">#37474F</color>       <!-- neutral secondary -->
    <color name="tp_btn_danger">#B71C1C</color>        <!-- destructive (STOP / QUIT) -->
    <color name="tp_btn_danger_dialog">#EF5350</color> <!-- destructive-confirm dialog highlight -->

    <!-- Status indicators (bright, used for text/dots that report a state) -->
    <color name="tp_state_go">#4CAF50</color>       <!-- connected / on / accepted -->
    <color name="tp_state_caution">#FF9800</color>  <!-- caution -->
    <color name="tp_state_danger">#F44336</color>   <!-- off / rejected / danger -->
    <!-- UNKNOWN is its own state and never collapses into "off" or into a guess — a standing
         rule, see CLAUDE.md. Same value as tp_hud_toggle_reconnect, which is the same idea on
         the HUD: in-between, not yet answerable. -->
    <color name="tp_state_unknown">#FFB74D</color>
    <color name="tp_state_go_soft">#CCFFCC</color>  <!-- pale confirmation text (debug) -->

    <!--
      FLIGHT-TUNED. Everything below was chosen against live video on the aircraft. Tokenised
      here so there is one source of truth, but the VALUES are results, not preferences.
    -->

    <!-- Crosshair accuracy ring — how far the look-point can be trusted. -->

    <!-- LIVE / REC toggles. The red is shared: both mean "this is going out right now". -->

    <!-- AR overlay contact colours. Magenta is ADS-B air traffic and is deliberately unlike
         anything else on the picture — see ArOverlayView.AIRCRAFT_COLOR. -->

    <!-- HUD text drop-shadow, so readouts stay legible over bright video. -->
    <color name="tp_shadow">#CC000000</color>
    <!-- Wash behind the flight-screen HUD text panels. 40% black: enough to lift the
         readouts off snow or wet asphalt, light enough to see movement through it.
         Flight-tuned (operator, 2026-08-04) — do not re-tune without the aircraft. -->
    <color name="tp_hud_panel_scrim">#66000000</color>
    <!-- Warning-banner severity tints. The banner sits on live video, so these are
         near-opaque: white text must stay legible over an arbitrary bright scene.
         Specification §4.8 names both values. -->
    <color name="tp_warn_banner_red">#E6B71C1C</color>
    <color name="tp_warn_banner_amber">#E6C15D00</color>

    <!-- FLIGHT-TUNED HUD COLOURS — specification §6.1. These were chosen against live video
         with the aircraft flying. Tokenising them must not re-tune them, and changing one
         needs the aircraft in front of you.

         Roles that share a value today are still separate tokens on purpose: the battery
         gauge's good band and the accuracy ring's good band are both #4CAF50 and are not the
         same decision. -->
    <color name="tp_hud_accuracy_good">#4CAF50</color>
    <color name="tp_hud_accuracy_fair">#FFEB3B</color>
    <color name="tp_hud_accuracy_poor">#F44336</color>
    <color name="tp_hud_battery_good">#4CAF50</color>
    <color name="tp_hud_battery_warn">#FFB74D</color>
    <color name="tp_hud_battery_critical">#F44336</color>
    <color name="tp_hud_signal_good">#4CAF50</color>
    <color name="tp_hud_signal_fair">#FFEB3B</color>
    <color name="tp_hud_signal_poor">#F44336</color>
    <color name="tp_hud_obstacle_warn">#FFCC00</color>
    <color name="tp_hud_obstacle_danger">#FF3B30</color>
    <color name="tp_hud_toggle_off">#3A3A3A</color>
    <color name="tp_hud_toggle_active">#E53935</color>
    <color name="tp_hud_toggle_reconnect">#FFB74D</color>
    <!-- NOT free to re-tune: it matches the magenta the ADS-B gateway tags its own tracks
         with, so the marker and the gateway's tracks read as the same thing. This token said
         #E91E63 until 2026-08-14 and no code used it; every tree drew #FF00FF. -->
    <color name="tp_ar_aircraft">#FF00FF</color>

    <!-- HUD CHROME — specification §6.1, ported from the Autel sibling 2026-09-13 (D14 to D18).
         Values are the sibling's exactly; a token that means one colour in one tree and another
         colour in another is the fault this file exists to prevent. -->

    <!-- The edge every HUD element carries over live video: the readouts, the EV slider and the
         mini-map's frame. It replaced the translucent panels, which covered the picture.
         ⚠ FULLY OPAQUE ON PURPOSE. tp_shadow is 80 % black and reads as a halo; this has to
         survive being HALF COVERED by the glyph fill drawn over it, so any transparency here
         shows as a grey smear rather than a border. -->
    <color name="tp_hud_outline">#FF000000</color>

    <!-- Fill behind a floating CONTROL capsule: the two toolbar clusters and the mini-map's
         zoom button. 70 % black, borrowed from TAK Aware's overlay-fill, which the operator's
         team runs alongside this application. A capsule may be this heavy where the readouts
         may not: it is a SMALL patch of the picture, and the icons in it keep their own colour
         rather than take an outline. -->
    <color name="tp_hud_capsule">#B3000000</color>

    <!-- TOGGLE-PILL FILLS AND STROKES — specification §6.7. A pill says its state with COLOUR,
         because the state has to be answerable from across the screen over a busy picture.
         The fills are their stroke colour at 30 %; they carry alpha, thus they cannot be a
         reference to the opaque token beside them and each is its own token.
         ⚠ tp_pill_unknown_fill and tp_pill_sync_fill hold the same value and are NOT the same
         decision: one means "the aircraft has not answered", the other "the link dropped and we
         are retrying". -->
    <color name="tp_pill_idle_fill">#33FFFFFF</color>
    <color name="tp_pill_idle_stroke">#99FFFFFF</color>
    <color name="tp_pill_active_fill">#4D4CAF50</color>
    <color name="tp_pill_unknown_fill">#4DFFB74D</color>
    <color name="tp_pill_live_fill">#4DE53935</color>
    <color name="tp_pill_sync_fill">#4DFFB74D</color>

</resources>

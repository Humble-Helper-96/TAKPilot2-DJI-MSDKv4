<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:navigationBarColor">@color/colorPrimary</item>
        <item name="actionMenuTextAppearance">@style/menu_item_appearance</item>
    </style>
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light"/>

    <!-- OptionsMenu text -->
    <style name="menu_item_appearance" parent="@android:style/TextAppearance.Holo.Widget.ActionBar.Menu">
        <item name="android:textSize">25sp</item>
    </style>


    <!-- List divider list -->
    <style name="set_divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1px</item>
        <item name="android:background">@android:color/black</item>
    </style>

    <!-- List item value style -->
    <style name="set_item_value">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/item_min_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">@dimen/item_value_size</item>
        <item name="android:layout_marginRight">15dp</item>
    </style>

    <!-- List item value style -->
    <style name="set_item_title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/item_min_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">@dimen/item_title_size</item>
        <item name="android:layout_marginLeft">15dp</item>
    </style>

    <!-- List item subtitle style -->
    <style name="listview_subtitle">
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14dp</item>
    </style>

    <!-- Common button style -->
    <style name="common_button">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">45dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/round_btn</item>
        <item name="android:paddingLeft">5dp</item>
        <item name="android:paddingRight">5dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="common_button_horizontal">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">45dp</item>
        <item name="android:background">@drawable/round_btn</item>
        <item name="android:paddingLeft">5dp</item>
        <item name="android:paddingRight">5dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="set_dialog" parent="@android:style/Theme.Holo.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFrame">@null</item>
    </style>

    <!-- FPV view style -->
    <style name="main_camera_view">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">150dp</item>
        <item name="android:layout_alignParentBottom">true</item>
        <item name="android:layout_marginLeft">10dp</item>
        <item name="android:layout_marginRight">10dp</item>
        <item name="android:layout_marginBottom">30dp</item>
    </style>

    <style name="test_text">
        <item name="android:shadowColor">@color/white</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">6</item>
        <item name="android:textSize">@dimen/test_log_textsize</item>
        <item name="android:textColor">@color/black</item>
    </style>


    <!-- ExpandableList  item title style -->
    <style name="expandable_item_title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/item_min_height</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textSize">@dimen/item_title_size</item>
        <item name="android:text">"Item name"</item>
    </style>

    <!-- ExpandableList  item title style -->
    <style name="expandable_second_level_item_title" parent="expandable_item_title">
        <item name="android:textColor">@color/gray</item>
    </style>


    <!-- ExpandableList item right arrow style -->
    <style name="expandable_item_right_arrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/item_min_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:textSize">@dimen/item_value_size</item>
        <item name="android:layout_marginRight">15dp</item>
        <item name="android:text">">"</item>
    </style>


    <!-- ExpandableList item down arrow style -->
    <style name="expandable_item_down_arrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/item_min_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_alignParentStart">true</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">@dimen/item_value_size</item>
        <item name="android:layout_marginLeft">@dimen/fab_margin</item>
        <item name="android:layout_marginRight">@dimen/fab_margin</item>
        <item name="android:text">"⌄"</item>
    </style>

    <style name="button_style">
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textColor">@drawable/common_text_color</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/round_btn</item>
    </style>

    <!-- TAKPilot2 Go connect screen -->
    <style name="takLabelStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#B0B0B0</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- Multi-column form row for the Pre-Flight Setup screen. Related short fields sit
         side-by-side instead of each taking a full row, which is what keeps that screen from
         running on for several scrolls. 4dp of margin per side gives 8dp between columns. -->
    <style name="takFormRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="takColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>
    <!-- Radio option sized to sit as one column of a takFormRow. -->
    <style name="takColumnRadio">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:buttonTint">#9AC4FF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- FOV calibration stepper (dialog_ar_fov). Compact so the row fits on a phone in
         landscape with the dialog over live video. -->
    <style name="takFovStepButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#37474F</item>
    </style>
    <style name="takFovValue">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="takFieldStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#666666</item>
        <item name="android:background">#2A2A2A</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- TAKPilot2 Go home screen -->
    <style name="homeCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">#1A1B1E</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="homeCardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#7A7A7A</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="homeCardValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">2dp</item>
    </style>
    <style name="homeCardSub">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#AAAAAA</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Dropped-marker dialogs (drop / markers list / row actions / inbound-hide) — same dark
         card + blue-accent language as the home screen (#0E0E10 bg, #1A1B1E cards, #9AC4FF
         accent) instead of the stock light AlertDialog.
         Built on AppCompat rather than the platform Theme.Material.Dialog.Alert: the platform
         theme left title/message/list-item text black on the Pixel 8 Pro test device (its
         Material-You dynamic-color overlay appears to win over a plain theme-attr override on
         those specific text roles) — AppCompat's own attr resolution doesn't have that
         override fight, so every text-bearing attr below actually takes effect. Custom
         windowBackground (tak_dialog_bg) replaces the default light panel; every text-color
         attr that AlertDialog's internal layouts can pull from is set explicitly (both the
         android: and plain forms) rather than relying on one to imply the others. -->
    <style name="TakDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/tak_dialog_bg</item>
        <item name="colorAccent">#9AC4FF</item>
        <item name="android:colorAccent">#9AC4FF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#AAAAAA</item>
        <item name="android:textColorPrimaryInverse">#FFFFFF</item>
        <item name="android:textColorAlertDialogListItem">#FFFFFF</item>
        <item name="android:editTextColor">#FFFFFF</item>
        <item name="android:textColorHint">#777777</item>
    </style>

    <!-- Same, but the positive/default-highlight color reads as a warning (delete / clear-all /
         inbound-hide confirms) — a red in the same family as the home screen's STOP/QUIT
         button (#B71C1C) rather than the app's blue accent. -->
    <style name="TakDialogTheme.Destructive">
        <item name="colorAccent">#EF5350</item>
        <item name="android:colorAccent">#EF5350</item>
    </style>

    <!-- Row for the icon+label lists (markers list panel, change-type picker) — an
         affiliation/type icon to the left of its text, matched to marker_{friendly,hostile,
         neutral,unknown}.xml so the picker reads the same shapes the map does. -->
    <style name="TakDialogListIcon">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginEnd">14dp</item>
    </style>
    <style name="TakDialogListLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <!-- Flight-screen HUD text. One style so every readout in the right-hand column shares a
         size and shadow — they sit over both video and black pillarbox, so the drop shadow is
         what keeps them legible in daylight. -->
    <style name="hudText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">3</item>
    </style>
</resources>

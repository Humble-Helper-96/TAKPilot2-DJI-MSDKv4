# Release signing — copy to app/keystore.properties and fill in.
#
# keystore.properties is GITIGNORED and must stay that way: it holds the passwords to the key
# that identifies every build of this app. Never commit it, and never send it alongside the APK.
#
# Create the keystore first (it will prompt for the passwords you put below):
#
#   keytool -genkeypair -v -keystore ~/takpilot2-release.jks \
#           -keyalg RSA -keysize 4096 -validity 10000 -alias takpilot2
#
# BACK THE .jks FILE UP. Losing it means no signed update can ever be installed over an existing
# copy — pilots would have to uninstall first, which wipes TAK enrollment, imported DTED tiles
# and dropped markers. There is no recovery path; Android identifies the app by this key.
#
# storeFile is resolved relative to the repo root, so an absolute path is safest.

storeFile=/home/YOUR-USER/takpilot2-release.jks
storePassword=
keyAlias=takpilot2
keyPassword=
